{
  "manifest_version": 3,
  "name": "CYHI Collaborative Form Workspace",
  "version": "1.0.0",
  "description": "Chrome extension shell for the Collaborative Form Workspace.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Collaborative Form Workspace",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["socket.io.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}

